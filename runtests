#!/usr/bin/env python3
"""Run lossless benchmarks and LC lossy/lossless-residual sweeps for matching SDR f32 files."""
import argparse
from pathlib import Path
import shlex
import subprocess
import sys

PROJECT = Path(__file__).resolve().parent
from benchmark_common import REPORT_ROOT, discover_inputs, INPUT_ROOT


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("inputs", nargs="*", help="Dataset path substrings; omitted means all inputs")
    parser.add_argument("--dry-run", action="store_true", help="Print commands without running benchmarks")
    parser.add_argument("--lc-dir", default=None)
    parser.add_argument("--csv", default=str(REPORT_ROOT / "lossless_results.csv"))
    parser.add_argument("--input-root", default=INPUT_ROOT)
    args = parser.parse_args()
    try:
        inputs = discover_inputs(args.inputs, args.input_root)
    except ValueError as error:
        parser.error(str(error))
    common_csv = str(Path(args.csv).expanduser().resolve())
    lc_options = ["--lc-dir", args.lc_dir] if args.lc_dir else []
    for phase in ("lossless", "two-part"):
        print(f"Starting {phase} tests", flush=True)
        for index, inp in enumerate(inputs, 1):
            print(f"[{phase} {index}/{len(inputs)}] {inp}", flush=True)
            if phase == "lossless":
                command = [
                    sys.executable, str(PROJECT / "lc_lossless_compress.py"), str(inp.relative_to(Path(args.input_root).expanduser().resolve())),
                    *lc_options, "--input-root", args.input_root, "--csv", common_csv,
                ]
            else:
                command = [
                    sys.executable, str(PROJECT / "lc_two_part_compress.py"), str(inp.relative_to(Path(args.input_root).expanduser().resolve())),
                    *lc_options, "--input-root", args.input_root, "--lossless-csv", common_csv,
                    "--lossy-preprocessor", "QUANT_IABS_0_f32",
                    "--lossy-pattern", ".+ .+ R.+|C.+|H.+",
                    "--lossless-pattern", ".+ .+ R.+|C.+|H.+",
                    "--epsilon-points", "5",
                ]
            print(shlex.join(command), flush=True)
            if not args.dry_run:
                subprocess.run(command, cwd=PROJECT, check=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        print(f"Benchmark failed (exit {error.returncode}); stopping batch.", file=sys.stderr)
        raise SystemExit(error.returncode)
